DJANGO_SECRET_KEY=replace-with-a-random-secret-at-least-50-characters-long
DJANGO_DEBUG=true
POSTGRES_DB=smartlead
POSTGRES_USER=postgres
POSTGRES_PASSWORD=replace-with-your-local-postgresql-password
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
CORS_ALLOWED_ORIGINS=http://localhost:5173
FRONTEND_URL=http://127.0.0.1:8000
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
DEFAULT_FROM_EMAIL=noreply@example.com
# SMTP settings apply when EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=true
ML_HIGH_THRESHOLD=0.7
ML_MEDIUM_THRESHOLD=0.4
# Optional: absolute path to a trusted locally trained model artifact
# ML_MODEL_PATH=

